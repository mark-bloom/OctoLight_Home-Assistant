<form class="form-horizontal">
    <h4>OctoLight (Home Assistant) settings</h4>
    <div class="control-group">
        <label class="control-label">Address</label>
        <div class="controls">
            <input type="text" class="input" data-bind="value: settings.plugins.octolightHA.address">
            <span class="help-block">The IP address or hostname of your HomeAssistant server. Use http://hostname:8123 or https://hostname. Trailing slashes are removed automatically.</span>
        </div>
    </div>
    <div class="control-group">
        <label class="control-label">Access token</label>
        <div class="controls">
            <input type="password" autocomplete="new-password" class="input" data-bind="value: settings.plugins.octolightHA.api_key">
            <span class="help-block">The long-lived access token generated by HomeAssistant. See external reference: <a href="https://github.com/edekeijzer/OctoPrint-PSUControl-HomeAssistant#configuration" target="_blank">plugin configuration</a> for more info.</span>
        </div>
    </div>
    <div class="control-group">
        <label class="control-label">Entity ID</label>
        <div class="controls">
            <input type="text" class="input" data-bind="value: settings.plugins.octolightHA.entity_id">
            <span class="help-block">The ID of the entity you'd like to control. Include its domain, for example light.printer or switch.desk_lamp. Lights, switches and input booleans are supported.</span>
        </div>
    </div>
    <div class="control-group">
        <div class="controls">
            <label class="checkbox">
            <input type="checkbox" data-bind="checked: settings.plugins.octolightHA.verify_certificate"> Verify certificate
            </label>
            <!-- ko if: settings.plugins.octolightHA.verify_certificate -->
            <span class="help-block">Verify TLS certificate and do not connect on certificate issues.</span>
            <!-- /ko -->
            <!-- ko ifnot: settings.plugins.octolightHA.verify_certificate -->
            <span class="help-block">Do not verify TLS certificate.</span>
            <!-- /ko -->
        </div>
    </div>
    <div class="control-group"><div class="controls">
        <button type="button" class="btn" data-bind="click: discover, disable: busy">Search Home Assistant</button>
        <button type="button" class="btn" data-bind="click: test, disable: busy">Test connection and entity</button>
        <p class="help-block" role="status" data-bind="text: message"></p>
        <input placeholder="Search entity name or ID" aria-label="Search entities" data-bind="textInput: search">
        <select size="5" aria-label="Home Assistant entities" data-bind="options: filteredEntities,
            optionsText: function(e) { return e.name + ' (' + e.entity_id + ')'; },
            value: selectedEntity, optionsCaption: 'Select an entity'"></select>
    </div></div>
    <div class="control-group"><label class="control-label">Status polling (seconds)</label><div class="controls">
        <input type="number" min="5" max="3600" data-bind="value: settings.plugins.octolightHA.pollInterval">
    </div></div>
    <div class="control-group"><label class="control-label">Navbar icon</label><div class="controls">
        <select data-bind="value: settings.plugins.octolightHA.icon"><option value="lightbulb">Lightbulb</option><option value="power-off">Power</option></select>
    </div></div>
    <hr style="width:50%;text-align:left;margin-left:0">
    <h5>Operational settings</h5>
    <div class="control-group">
        <div class="controls">
            <label class="checkbox">
                <input type="checkbox" data-bind="checked: settings.plugins.octolightHA.turnOnPrintStart"> Turn on light on print start </label>
        </div>
    </div>
    <div class="control-group">
        <div class="controls">
            <label class="checkbox">
                <input type="checkbox" data-bind="checked: settings.plugins.octolightHA.turnOffPrintEnd"> Turn off light on print end </label>
        </div>
    </div>
    <div class="control-group">
        <div class="controls">
            <label class="input-append">
                <input type="number" min="0" class="input-mini text-right" data-bind="value: settings.plugins.octolightHA.turnOffPrintDelay">
                <span class="add-on">min</span>
            </label>
            <span class="help-block">Time for light to remain on after print end</span>
        </div>
    </div>
    <div class="control-group">
        <div class="controls">
            <label class="checkbox">
                <input type="checkbox" data-bind="checked: settings.plugins.octolightHA.turnOffPrintFailure"> Turn off light on print failure </label>
        </div>
    </div>
    <div class="control-group">
        <div class="controls">
            <label class="checkbox">
                <input type="checkbox" data-bind="checked: settings.plugins.octolightHA.turnOffPrintCancellation"> Turn off light on print cancellation </label>
        </div>
    </div>
    <h5>Additional lights and switches</h5>
    <p>Use the search results above to copy a complete entity ID. Each entity has its own print settings.</p>
    <!-- ko foreach: settings.plugins.octolightHA.additionalEntities -->
    <div class="octolight-entity">
        <label>Entity ID <input data-bind="value: entity_id" placeholder="light.room"></label>
        <label>Icon <select data-bind="value: icon"><option value="lightbulb">Lightbulb</option><option value="power-off">Power</option></select></label>
        <label class="checkbox"><input type="checkbox" data-bind="checked: turnOnPrintStart">Turn on at print start</label>
        <label class="checkbox"><input type="checkbox" data-bind="checked: turnOffPrintEnd">Turn off at print end</label>
        <label>Delay (minutes) <input type="number" min="0" max="1440" data-bind="value: turnOffPrintDelay"></label>
        <label class="checkbox"><input type="checkbox" data-bind="checked: turnOffPrintFailure">Turn off on failure</label>
        <label class="checkbox"><input type="checkbox" data-bind="checked: turnOffPrintCancellation">Turn off on cancellation</label>
        <button type="button" class="btn" data-bind="click: $root.removeEntity">Remove</button>
    </div>
    <!-- /ko -->
    <button type="button" class="btn" data-bind="click: addEntity">Add entity</button>
</form>
